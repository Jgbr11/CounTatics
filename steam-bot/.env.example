# ═══════════════════════════════════════════════════════
#  CounTatic Steam Bot — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════

# ─── Credenciais da Steam ──────────────────────────────
# A conta deve ter o Steam Guard desabilitado OU usar
# um shared secret para geração automática de 2FA codes.
STEAM_USERNAME=seu_usuario_steam
STEAM_PASSWORD=sua_senha_steam

# (Opcional) Shared secret para autenticação 2FA automática.
# Se não fornecido, o bot pedirá o código manualmente no console.
# STEAM_SHARED_SECRET=seu_shared_secret_base64

# ─── Servidor HTTP ─────────────────────────────────────
BOT_PORT=3000

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=info
