# ═══════════════════════════════════════════════════════
#  CounTatic Steam Bot — Variáveis de Ambiente (exemplo)
#
#  Copie para steam-bot/.env e preencha com valores reais:
#      Copy-Item steam-bot/.env.example steam-bot/.env
#
#  É ESTE arquivo que o bot lê. O docker-compose.yml o carrega
#  via `env_file: ./steam-bot/.env`; o .env da raiz do projeto
#  NÃO alimenta o bot — ele guarda os segredos do core-backend.
#
#  ⚠️ NUNCA coloque valores reais neste .env.example: ele é
#     versionado de propósito (a regra `!.env.example` do
#     .gitignore o desprotege), então qualquer coisa escrita
#     aqui vai para o histórico do git e para todo mundo que
#     clonar o repositório.
# ═══════════════════════════════════════════════════════

# ─── Credenciais da Steam ──────────────────────────────
# Conta secundária dedicada, NUNCA a sua conta pessoal.
#
# ⚠️ PRÉ-REQUISITO OBRIGATÓRIO: esta conta precisa ter
#    Counter-Strike 2 (appid 730) na biblioteca. Sem a
#    licença do 730 o Game Coordinator ignora o handshake
#    e nenhuma estatística de partida é obtida.
#    Veja docs/SETUP-BOT-ACCOUNT.md
STEAM_USERNAME=seu_usuario_bot
STEAM_PASSWORD=sua_senha_bot

# (Opcional) Shared secret do autenticador mobile, para 2FA automático.
# Sem ele, o primeiro login pede o código por e-mail uma única vez
# (depois o refreshToken.txt cuida do resto).
# STEAM_SHARED_SECRET=seu_shared_secret_base64

# ─── Servidor HTTP ─────────────────────────────────────
BOT_PORT=3000

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=info
