# ═══════════════════════════════════════════════════════
#  CounTatic — Variáveis de Ambiente (exemplo)
#
#  Copie para .env e preencha com valores reais.
#  O .env NÃO deve ser commitado.
#      Copy-Item .env.example .env
# ═══════════════════════════════════════════════════════

# ─── Conta Steam do BOT ────────────────────────────────
# Conta secundária dedicada, NUNCA a sua conta pessoal.
#
# ⚠️ PRÉ-REQUISITO OBRIGATÓRIO: esta conta precisa ter
#    Counter-Strike 2 (appid 730) na biblioteca.
#    Sem a licença do 730, o Game Coordinator ignora o
#    handshake e nenhuma estatística de partida é obtida.
#    Veja docs/SETUP-BOT-ACCOUNT.md
STEAM_USERNAME=seu_usuario_bot
STEAM_PASSWORD=sua_senha_bot

# (Opcional) Shared secret do autenticador mobile, para 2FA automático.
# Sem ele, o primeiro login pede o código por e-mail uma única vez
# (depois o refreshToken.txt cuida do resto).
# STEAM_SHARED_SECRET=

# SteamID64 da conta do bot. Usado para impedir que ela seja
# cadastrada como jogador (o que gera 403 da Valve a cada ciclo).
BOT_STEAM_ID=

# ─── Steam Web API ─────────────────────────────────────
# Gere em https://steamcommunity.com/dev/apikey (gratuito).
# Diferente do Game Authentication Code do jogador.
STEAM_WEB_API_KEY=

# ─── Servidor HTTP do bot ──────────────────────────────
BOT_PORT=3000
LOG_LEVEL=info

# ─── Game State Integration (gatilho instantâneo) ──────
# Segredo compartilhado entre o CS2 e o core-backend. Gere um valor
# aleatório e use O MESMO em docs/gamestate_integration_countatic.cfg.
#   PowerShell:  [guid]::NewGuid().ToString()
# Vazio faz POST /api/gsi recusar tudo.
GSI_TOKEN=
