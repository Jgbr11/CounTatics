# ═══════════════════════════════════════════════════════
#  CounTatic — Variáveis de Ambiente (exemplo)
#
#  Copie para .env e preencha com valores reais.
#  O .env NÃO deve ser commitado.
#      Copy-Item .env.example .env
#
#  ⚠️ São DOIS arquivos de ambiente, com escopos diferentes:
#
#    .env (este)        → segredos que o docker-compose.yml
#                         interpola para o core-backend.
#    steam-bot/.env     → credenciais da conta Steam do bot.
#                         O compose o carrega via `env_file:`,
#                         e o bot NÃO lê o .env da raiz.
#                         Modelo em steam-bot/.env.example.
#
#  Preencher só este deixa o steam-bot morrendo no boot com
#  "ERRO DE CONFIGURAÇÃO: variáveis de ambiente obrigatórias
#  não definidas". Os dois precisam existir.
#
#  ⚠️ NUNCA coloque valores reais neste .env.example: ele é
#     versionado de propósito e vai para o histórico do git.
# ═══════════════════════════════════════════════════════

# ─── Conta Steam do BOT ────────────────────────────────
# ⚠️ STEAM_USERNAME e STEAM_PASSWORD NÃO ficam aqui.
#    Elas vão em steam-bot/.env — ver steam-bot/.env.example.
#
# SteamID64 da conta do bot. Usado para impedir que ela seja
# cadastrada como jogador (o que gera 403 da Valve a cada ciclo).
BOT_STEAM_ID=

# ─── Steam Web API ─────────────────────────────────────
# Gere em https://steamcommunity.com/dev/apikey (gratuito).
# Diferente do Game Authentication Code do jogador.
STEAM_WEB_API_KEY=

# ─── Game State Integration (gatilho instantâneo) ──────
# Segredo compartilhado entre o CS2 e o core-backend. Gere um valor
# aleatório e use O MESMO em docs/gamestate_integration_countatic.cfg.
#   PowerShell:  [guid]::NewGuid().ToString()
# Vazio faz POST /api/gsi recusar tudo.
GSI_TOKEN=

# ─── Login com a Steam ─────────────────────────────────
# Chave que assina o cookie de sessão. Sem ela o login fica
# DESLIGADO — de propósito: um valor padrão no código seria
# público junto com o repositório, e qualquer um poderia
# assinar um cookie de qualquer conta.
#   PowerShell:  [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
# Trocar esta chave desloga todo mundo (as assinaturas antigas
# deixam de conferir) — o que é justamente o que se quer se ela vazar.
SESSION_SECRET=

# Endereço público do site. Entra no link enviado no chat da Steam
# e no retorno do login — a Steam volta exatamente para cá.
# Em https, o cookie de sessão passa a ser marcado Secure automaticamente.
WEB_BASE_URL=http://localhost:8080
